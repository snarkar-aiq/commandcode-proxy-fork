// opencode.jsonc — Template configuration for commandcode-proxy
//
// Copy the `provider.commandcode` block into your ~/.config/opencode/opencode.json
// or opencode.jsonc, then restart OpenCode (or press F5 to reload).
//
// IMPORTANT (OpenCode v1 AND v2):
//   * Use the SINGULAR top-level key `provider`. A plural `providers` block is
//     silently ignored by OpenCode v1 and rejected as malformed by v2 — this is
//     the #1 reason models don't show up.
//   * `npm` must be "@ai-sdk/openai-compatible" (v1 only recognizes the
//     OpenAI-compatible SDK adapter under that package name).
//   * Model variant `thinking.budgetTokens` is camelCase (budget_tokens is not
//     recognized).
//
// Key resolution order (no config needed if you've run /connect):
//   1. COMMANDCODE_API_KEY env var
//   2. Bearer token forwarded by OpenCode's /connect
//   3. ~/.local/share/opencode/auth.json → `commandcode` key
//
// If you DON'T want to rely on auth.json and prefer env var, uncomment:
//   "env": ["COMMANDCODE_API_KEY"]

{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "commandcode-direct": {
      "name": "CommandCode Direct (GOAT)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://api.commandcode.ai/provider/v1"
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "id": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "high", "thinking": { "type": "enabled", "budgetTokens": 16000 } }
          }
        },
        "deepseek/deepseek-v4.1-flash": {
          "id": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "high", "thinking": { "type": "enabled", "budgetTokens": 16000 } }
          }
        },
        "deepseek/deepseek-v4-flash-fast": {
          "id": "deepseek/deepseek-v4-flash-fast",
          "name": "DeepSeek V4 Flash Fast",
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "high", "thinking": { "type": "enabled", "budgetTokens": 16000 } }
          }
        },
        "meituan/LongCat-2.0:free": {
          "id": "meituan/LongCat-2.0:free",
          "name": "LongCat-2.0:Free",
          "variants": {
            "think": { "thinking": { "type": "enabled", "budgetTokens": 8000 } }
          }
        },
        "zai-org/glm-5.3-flash": {
          "id": "zai-org/glm-5.3-flash",
          "name": "GLM-5.3-Flash",
          "variants": {
            "think": { "thinking": { "type": "enabled", "budgetTokens": 8000 } }
          }
        },
        "meta/muse-spark-1.3-contributor": {
          "id": "meta/muse-spark-1.3-contributor",
          "name": "Muse Spark 1.3 Contributor",
          "variants": {
            "low": { "thinking": { "type": "enabled", "budgetTokens": 4000 } },
            "high": { "thinking": { "type": "enabled", "budgetTokens": 8000 } },
            "xhigh": { "thinking": { "type": "enabled", "budgetTokens": 16000 } }
          }
        },
        "meta/muse-spark-1.2-contributor": {
          "id": "meta/muse-spark-1.2-contributor",
          "name": "Muse Spark 1.2 Contributor",
          "variants": {
            "think": { "thinking": { "type": "enabled", "budgetTokens": 8000 } }
          }
        }
      }
    },
    "commandcode": {
      "name": "CommandCode Go (via local proxy)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:18731/v1"
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "id": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "high", "thinking": { "type": "enabled", "budgetTokens": 16000 } }
          }
        },
        "deepseek/deepseek-v4.1-flash": {
          "id": "deepseek/deepseek-v4.1-flash",
          "name": "DeepSeek V4.1 Flash",
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "high", "thinking": { "type": "enabled", "budgetTokens": 16000 } }
          }
        },
        "deepseek/deepseek-v4-flash-fast": {
          "id": "deepseek/deepseek-v4-flash-fast",
          "name": "DeepSeek V4 Flash Fast",
          "variants": {
            "low": { "reasoningEffort": "low" },
            "medium": { "reasoningEffort": "medium" },
            "high": { "reasoningEffort": "high" },
            "max": { "reasoningEffort": "high", "thinking": { "type": "enabled", "budgetTokens": 16000 } }
          }
        },
        "meituan/LongCat-2.0:free": {
          "id": "meituan/LongCat-2.0:free",
          "name": "LongCat-2.0:Free",
          "variants": {
            "think": { "thinking": { "type": "enabled", "budgetTokens": 8000 } }
          }
        },
        "zai-org/glm-5.3-flash": {
          "id": "zai-org/glm-5.3-flash",
          "name": "GLM-5.3-Flash",
          "variants": {
            "think": { "thinking": { "type": "enabled", "budgetTokens": 8000 } }
          }
        },
        "meta/muse-spark-1.3-contributor": {
          "id": "meta/muse-spark-1.3-contributor",
          "name": "Muse Spark 1.3 Contributor",
          "variants": {
            "low": { "thinking": { "type": "enabled", "budgetTokens": 4000 } },
            "high": { "thinking": { "type": "enabled", "budgetTokens": 8000 } },
            "xhigh": { "thinking": { "type": "enabled", "budgetTokens": 16000 } }
          }
        },
        "meta/muse-spark-1.2-contributor": {
          "id": "meta/muse-spark-1.2-contributor",
          "name": "Muse Spark 1.2 Contributor",
          "variants": {
            "think": { "thinking": { "type": "enabled", "budgetTokens": 8000 } }
          }
        }
      }
    }
  }
}